# V3 — Email (Resend — resend.com)
# Sign up at resend.com, create an API key, and add it here.
# RESEND_FROM must be an address on a domain you verified in Resend,
# or use onboarding@resend.dev for testing (delivers only to your own email).
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Gone by Monday <noreply@yourdomain.com>
OWNER_EMAIL=gonebymondayllc@gmail.com

# Legacy — kept for reference, no longer used for sending
# GMAIL_USER=gonebymondayllc@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password_here

