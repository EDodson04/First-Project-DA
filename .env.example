# Pricing
BASE_QUARTER_LOAD=100
BASE_HALF_LOAD=200
BASE_THREE_QUARTER_LOAD=300
BASE_FULL_LOAD=400
TIRE_SURCHARGE=15
APPLIANCE_SURCHARGE=25
MATTRESS_SURCHARGE=20
