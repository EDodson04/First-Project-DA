# Business Settings
BUSINESS_NAME=Gone by Monday
BUSINESS_PHONE=+14355550001
OWNER_PHONE=+14355550002
BUSINESS_TIMEZONE=America/Denver
LANDFILL_ADDRESS=Logan Landfill, Logan, UT 84321
LANDFILL_ROUNDTRIP_MINUTES=60
DAILY_START_TIME=08:00
DAILY_END_TIME=18:00
